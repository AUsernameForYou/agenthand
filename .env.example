# agenthand environment - copy to .env and fill in locally.
# Placeholder NAMES only. Never commit a real .env file.

# Meta Model API key (server-side only; a dedicated judge key is used for
# judged traffic - never put either in source control)
META_API_KEY=

# Local data directory: asset store + JSONL cost ledger live here.
# Defaults to ./data under the project root when unset.
AGENTHAND_DATA_DIR=

# Fail-closed total spend cap in USD across ALL billable model calls.
# Calls refuse before they run if they would push the ledger past this.
# Default when unset: 120.00 working cap. This variable may only LOWER
# the cap; values above the 150.00 hard ceiling are clamped to it.
AGENTHAND_TOTAL_SPEND_CAP_USD=120.00
